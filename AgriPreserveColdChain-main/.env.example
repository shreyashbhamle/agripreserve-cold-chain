# AgriPreserve International Agricultural Logistics & Supply Chain Platform
# Copy this file to .env and replace placeholders with your credentials.
# Never commit real API keys, merchant secrets, or database passwords.

# 1. Server & CORS Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# 2. Database Configuration (Default: local SQLite backend/agripreserve.db)
DATABASE_URL=sqlite:///./backend/agripreserve.db

# 3. Mapping & Routing Provider (Default: OpenStreetMap + OSRM public routing adapter)
ROUTING_PROVIDER_URL=https://router.project-osrm.org
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_placeholder
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_placeholder

# 4. International Customs & Tariff Data Adapter (Optional government / broker feed)
CUSTOMS_TARIFF_API_URL=https://api.example-customs-tariff.org/v1
CUSTOMS_TARIFF_API_KEY=your_customs_tariff_api_key_placeholder
FX_RATES_API_KEY=your_exchange_rate_api_key_placeholder

# 5. External Agricultural Market Intelligence (Optional India data.gov.in / AGMARKNET)
AGMARKNET_API_KEY=your_data_gov_in_api_key_placeholder

# 6. Notification Providers (Optional Email / SMS / WhatsApp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_placeholder
SMTP_PASSWORD=your_smtp_password_placeholder
TWILIO_ACCOUNT_SID=your_twilio_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder

# 7. Payment Gateway Configuration (Optional - never store raw card details)
PAYMENT_GATEWAY_PROVIDER=stripe_or_razorpay_placeholder
PAYMENT_GATEWAY_KEY_ID=your_merchant_key_id_placeholder
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_webhook_secret_placeholder

# 8. Optional AI / LLM Provider (Falls back to local SOP RAG + IsolationForest when unset)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
